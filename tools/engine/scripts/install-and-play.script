# After boot: unlock, check the shell answers, install the APK the runner was
# given, start it, and record the screen along the way.
# Long enough for a slow host to finish settling; a swipe sent too early
# is ignored (seen once on Windows).
wait 20
screenshot lock.ppm
swipe 360 1150 360 250 350
wait 4
screenshot after-swipe.ppm
# The marker is split so the shell's echo of this line does not match it.
shell id; getprop ro.build.version.release; echo GD_""SHELL_OK
expect GD_SHELL_OK 40
# How big Android made the storage for games and data.
shell echo GD_""DATA_KB=$(df -k /data | tail -n 1 | tr -s " " | cut -d " " -f 2)
expect GD_DATA_KB= 20
# Which clock the kernel settled on, and how many processors it has.
shell echo GD_""CLOCK=$(su 0 cat /sys/devices/system/clocksource/clocksource0/current_clocksource) GD_""CPUS=$(nproc)
expect GD_CPUS= 20
# The network: what Android sees, and whether a web server answers.
shell echo GD_""NET_BEGIN; ls /sys/class/net; ip -o -4 addr; ip route; echo GD_""NET_END
expect GD_NET_END 20
shell printf 'HEAD / HTTP/1.0\r\nHost: example.com\r\n\r\n' | toybox nc -w 10 example.com 80 | head -n 1; echo GD_""HTTP_DONE
expect GD_HTTP_DONE 40
shell echo GD_""ETH_BEGIN; su 0 dumpsys ethernet | grep -E "eth1|IpClient|filter" | cut -c1-600; echo GD_""ETH_END
expect GD_ETH_END 20
shell echo GD_""RC_BEGIN; su 0 grep -rhE "wifi|wlan|rename_eth|disable_rename|virt_wifi|hwsim" /vendor/etc/init /system/etc/init /system_ext/etc/init 2>/dev/null | head -n 40; echo GD_""RC_END
expect GD_RC_END 20
shell echo GD_""PROP_BEGIN; getprop | grep -iE "wifi|ethernet|rename|netsim|radio.multisim|ril" | head -n 30; cmd overlay lookup android android:array/config_ethernet_interfaces; echo GD_""PROP_END
expect GD_PROP_END 20
# By hand, below Android's own network management: does the path carry?
shell su 0 sh -c 'ip addr add 10.0.2.15/24 dev eth1; ip link set eth1 up; ip rule add from all lookup main pref 1; ip route add default via 10.0.2.2 dev eth1'; echo GD_""HAND_SET
expect GD_HAND_SET 20
shell echo GD_""HAND_BEGIN; su 0 ping -c 2 -W 3 10.0.2.2 | tail -n 3; printf 'HEAD / HTTP/1.0\r\n\r\n' | su 0 toybox nc -w 10 1.1.1.1 80 | head -n 1; echo GD_""HAND_END
expect GD_HAND_END 60
shell dumpsys connectivity | grep -iE "Active default network|NetworkAgentInfo.*(VALIDATED|ETHERNET)" | head -n 4; echo GD_""CONN_DONE
expect GD_CONN_DONE 20
install
start PACKAGE
expect GD_START_STATUS=0 60
wait 30
# The game must really be in front, not hidden behind a lock screen.
shell dumpsys activity activities | grep -q "ResumedActivity.*PACKAGE" && echo GD_""FRONT_OK
expect GD_FRONT_OK 30
screenshot game-1.ppm
# A tap in the middle of the screen, then look again.
tap 360 640
wait 12
screenshot game-2.ppm

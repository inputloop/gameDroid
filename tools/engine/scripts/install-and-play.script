# After boot: unlock, check the shell answers, install the APK the runner was
# given, start it, and record the screen along the way.
# Long enough for a slow host to finish settling; a swipe sent too early
# is ignored (seen once on Windows).
wait 20
screenshot lock.ppm
swipe 360 1150 360 250 350
wait 4
screenshot after-swipe.ppm
# The marker is split so the shell's echo of this line does not match it.
shell id; getprop ro.build.version.release; echo GD_""SHELL_OK
expect GD_SHELL_OK 40
# How big Android made the storage for games and data.
shell echo GD_""DATA_KB=$(df -k /data | tail -n 1 | tr -s " " | cut -d " " -f 2)
expect GD_DATA_KB= 20
# Which clock the kernel settled on, and how many processors it has.
shell echo GD_""CLOCK=$(su 0 cat /sys/devices/system/clocksource/clocksource0/current_clocksource) GD_""CPUS=$(nproc)
expect GD_CPUS= 20
install
start PACKAGE
expect GD_START_STATUS=0 60
wait 30
# The game must really be in front, not hidden behind a lock screen.
shell dumpsys activity activities | grep -q "ResumedActivity.*PACKAGE" && echo GD_""FRONT_OK
expect GD_FRONT_OK 30
screenshot game-1.ppm
# A tap in the middle of the screen, then look again.
tap 360 640
wait 12
screenshot game-2.ppm

# After boot: unlock, check the shell answers, install the APK the runner was
# given, start it, and record the screen along the way.
# Long enough for a slow host to finish settling; a swipe sent too early
# is ignored (seen once on Windows).
wait 20
screenshot lock.ppm
swipe 360 1150 360 250 350
wait 4
screenshot after-swipe.ppm
# The marker is split so the shell's echo of this line does not match it.
shell id; getprop ro.build.version.release; echo GD_""SHELL_OK
expect GD_SHELL_OK 40
# How big Android made the storage for games and data.
shell echo GD_""DATA_KB=$(df -k /data | tail -n 1 | tr -s " " | cut -d " " -f 2)
expect GD_DATA_KB= 20
# Which clock the kernel settled on, and how many processors it has.
shell echo GD_""CLOCK=$(su 0 cat /sys/devices/system/clocksource/clocksource0/current_clocksource) GD_""CPUS=$(nproc)
expect GD_CPUS= 20
# The help page: stored on the phone, opened in the browser, and really
# the page (its title is what the browser's window is called).
help
wait 8
screenshot help.ppm
shell su 0 ls -l /data/data/org.chromium.webview_shell/files/; su 0 dumpsys activity activities | grep -q "ResumedActivity.*webview_shell" && echo GD_""HELP_FRONT
expect GD_HELP_FRONT 30
key 172
wait 2
# Which browser the image has, and what opens a web address.
shell echo GD_""WEB_BEGIN; pm list packages | grep -iE "browser|webview|chrom|search"; cmd package resolve-activity --brief -a android.intent.action.VIEW -d http://example.com | tail -n 1; cmd package query-activities --brief -a android.intent.action.MAIN -c android.intent.category.APP_BROWSER | tail -n 3; echo GD_""WEB_END
expect GD_WEB_END 40
# Who is drawing: Android's Vulkan driver, and the renderer its OpenGL ES
# reports.
shell echo GD_""GPU_BEGIN; getprop ro.hardware.vulkan; su 0 dumpsys SurfaceFlinger | grep -m1 "GLES:" | cut -c1-200; echo GD_""GPU_END
expect GD_GPU_END 40
# The network. Join the virtual Wi-Fi as the app does, then look.
shell su 0 sh -c '[ -e /sys/class/net/wlan0 ] && echo GD_WLAN_BY_IMAGE || { ip link add link buried_eth2 name wlan0 type virt_wifi; ip link set buried_eth2 up; echo GD_WLAN_BY_HAND; }; cmd wifi set-wifi-enabled enabled; sleep 3; cmd wifi connect-network VirtWifi open'; echo GD_""WIFI_ASKED
expect GD_WIFI_ASKED 30
wait 15
shell echo GD_""NET_BEGIN; ls /sys/class/net | tr '\n' ' '; echo; ip -o -4 addr; su 0 cmd wifi status | head -n 8; su 0 cmd wifi list-scan-results | head -n 4; echo GD_""NET_END
expect GD_NET_END 20
shell printf 'HEAD / HTTP/1.0\r\nHost: example.com\r\n\r\n' | su 0 toybox nc -w 10 example.com 80 | head -n 1; echo GD_""HTTP_DONE
expect GD_HTTP_DONE 40
shell dumpsys connectivity | grep -iE "Active default network|NetworkAgentInfo" | cut -c1-300 | head -n 4; echo GD_""CONN_DONE
expect GD_CONN_DONE 20
# Android itself must have reached the internet through it: its own check
# fetches a page from Google's servers and marks the network validated.
shell dumpsys connectivity | grep -q "Active default network: [0-9]" && dumpsys connectivity | grep -q "EVER_VALIDATED&IS_VALID" && echo GD_""ONLINE
expect GD_ONLINE 30
install
start PACKAGE
expect GD_START_STATUS=0 60
wait 30
# The game must really be in front, not hidden behind a lock screen.
shell dumpsys activity activities | grep -q "ResumedActivity.*PACKAGE" && echo GD_""FRONT_OK
expect GD_FRONT_OK 30
screenshot game-1.ppm
# A tap in the middle of the screen, then look again.
tap 360 640
wait 12
screenshot game-2.ppm
